# ============================================================
# blmtrm terminal environment template
# Copy this file to terminal/.env and fill in your values.
# NEVER commit .env — it is git-ignored.
# ============================================================

# Anthropic — required for the AI Agent panel
ANTHROPIC_API_KEY=

# Database — SQLite is used by default (no DATABASE_URL needed).
# Set DATABASE_URL to use PostgreSQL or another database.
# DATABASE_URL=

# Back-navigation link in the terminal TopBar
# In development this points to the Vite dev server.
# In production it defaults to "/" (the Express server root).
VITE_DASHBOARD_URL=http://localhost:5173

# Port the terminal dev server listens on (default: 5000)
PORT=5000
