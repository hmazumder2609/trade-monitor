# ============================================================
# trade-monitor environment template
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is git-ignored.
# ============================================================

# ── Stocks ──────────────────────────────────────────────────
# Finnhub provides real-time and historical stock data.
# REQUIRED for stock quotes, charts, and symbol search.
# Get a free key at: https://finnhub.io/register
FINNHUB_API_KEY=

# ── News ────────────────────────────────────────────────────
# NewsAPI aggregates headlines from thousands of sources.
# Optional — RSS feeds work without it.
# Free tier: https://newsapi.org/register
NEWSAPI_KEY=

# ── Code / GitHub ───────────────────────────────────────────
# GitHub PAT with repo + actions:read scope for CI status.
# REQUIRED for the Code Status panel.
# Create: Settings > Developer settings > Personal access tokens
GITHUB_PAT=

# ── Email (Gmail OAuth2) ───────────────────────────────────
# Gmail OAuth requires a Google Cloud project.
# Guide: https://developers.google.com/gmail/api/quickstart/nodejs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_ENABLED=

# ── Email (Outlook / Microsoft Graph) ──────────────────────
# Microsoft Graph API access via OAuth2.
# App registration: https://portal.azure.com > App registrations
OUTLOOK_CLIENT_ID=
OUTLOOK_REFRESH_TOKEN=

# ── Feishu / Lark ──────────────────────────────────────────
# Feishu bot integration for workplace messaging.
# REQUIRED for the Feishu panel.
# Create app: https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── Social ──────────────────────────────────────────────────
# Twitter/X API v2 for social sentiment analysis.
# Free tier: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# Reddit API for social sentiment mentions.
# Free: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── AI (Dashboard) ─────────────────────────────────────────
# OpenRouter provides access to 200+ LLMs (GPT-4o, Claude, etc.).
# Powers AI summaries, insights, and the trading agent.
# Sign up: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── AI (Terminal subproject) ──────────────────────────────
# Anthropic Claude API for the blmtrm terminal AI agent.
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Trading (SnapTrade) ────────────────────────────────────
# SnapTrade connects brokerage accounts (TD Ameritrade, etc.).
# REQUIRED for the Trading panel and trade import.
# Dashboard: https://dashboard.snaptrade.com/
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# ── Macro Economics ────────────────────────────────────────
# FRED API from the St. Louis Fed for GDP, CPI, unemployment, etc.
# REQUIRED for the Macro tab (Economic Indicators, Yield Curve).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Options ────────────────────────────────────────────────
# CBOE data for put/call ratios and options flow analysis.
# Optional — free tier available.
CBOE_API_KEY=

# ── On-Chain (Crypto) ──────────────────────────────────────
# Glassnode provides on-chain analytics (whale transactions, etc.).
# Paid — optional.
GLASSNODE_API_KEY=

# Whale Alert tracks large crypto transactions >$500k.
# Free tier at: https://whale-alert.io/api
WHALE_ALERT_API_KEY=

# ── Server ─────────────────────────────────────────────────
API_TOKEN=
PORT=
