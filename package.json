{
  "name": "my-daily-monitor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "dev:terminal": "cd src/terminal && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\" \"npm run dev:terminal\"",
    "install:terminal": "cd src/terminal && npm install",
    "build": "tsc && vite build",
    "build:terminal": "cd src/terminal && NODE_ENV=production npm run build",
    "build:all": "npm run build && tsc -p tsconfig.server.json && npm run build:terminal",
    "start": "node --import tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type:check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src server tests",
    "lint:fix": "eslint src server tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "lightweight-charts": "^5.2.0",
    "maplibre-gl": "^5.19.0",
    "snaptrade-typescript-sdk": "^9.0.179",
    "tsx": "^4.21.0",
    "ws": "^8.21.0"
  }
}
